NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_URL=http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,https://shirunjies8-png.github.io
JWT_SECRET=change-me
DB_PATH=./database/personal-ai-os.sqlite3
UPLOADS_DIR=./uploads
LOGS_DIR=./logs
BACKUPS_DIR=./backups
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_MAX_OUTPUT_TOKENS=1500
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_DAILY_REQUEST_LIMIT=100
DEEPSEEK_ENTERPRISE_DAILY_REQUEST_LIMIT=1000
DEEPSEEK_DAILY_TOKEN_LIMIT=200000
DEEPSEEK_DAILY_BUDGET=10
DEEPSEEK_MONTHLY_BUDGET=50
DEEPSEEK_SYSTEM_DAILY_TOKEN_LIMIT=1000000
DEEPSEEK_SYSTEM_DAILY_BUDGET=100
DEEPSEEK_SYSTEM_MONTHLY_BUDGET=250
DEEPSEEK_AGENT_DAILY_TOKEN_LIMIT=100000
DEEPSEEK_MAX_INPUT_CHARS=120000
DEEPSEEK_MAX_CONTEXT_TOKENS=64000
DEEPSEEK_MAX_REQUEST_BYTES=1048576
DEEPSEEK_HIGH_COST_TOKEN_THRESHOLD=12000
DEEPSEEK_CACHE_TTL_SECONDS=86400
DEEPSEEK_CIRCUIT_FAILURE_THRESHOLD=3
DEEPSEEK_CIRCUIT_COOLDOWN_MS=60000
CAPABILITY_AI=true
CAPABILITY_AGENTS=true
CAPABILITY_SKILLS=true
CAPABILITY_WORKFLOWS=true
# 高风险能力默认关闭；生产环境按需显式启用。
CAPABILITY_EXTERNAL_NETWORK=false
CAPABILITY_FILE_GENERATION=false
MAIL_AGENT_BASE_URL=
MAIL_AGENT_API_KEY=
DEFAULT_ADMIN_EMAIL=admin@personal-ai-os.local
DEFAULT_ADMIN_PASSWORD=123456
DEFAULT_ENTERPRISE_NAME=Personal AI OS Demo Enterprise
